VITE_PUBLIC_API=
VITE_HTTPS_DEVELOPMENT=false
# Brandfetch Brand Search API (clientId publico, frontend-safe)
VITE_BRANDFETCH_CLIENT_ID=
# WhatsApp de ventas para activar planes de pago (ej. 51999999999). Opcional.
