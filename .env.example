# Google Sign-In: ID de cliente OAuth (opcional; sin él se oculta el botón)
VITE_GOOGLE_CLIENT_ID=

# Correo de contacto para las páginas de privacidad y términos (opcional)
VITE_SUPPORT_EMAIL=
