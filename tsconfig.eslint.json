// tsconfig.eslint.json
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@test/*": ["test/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.d.ts",
    "test/**/*.ts",
    "test/**/*.tsx",
    "vite.config.ts",
    "vite-env.d.ts",
    "vitest.config.ts",
    "eslint.config.js"
  ],
  "references": []
}
